{
  "name": "VoltronicMAX",
  "version": "1.1.1",
  "description": "Full-featured, memory-optimized Arduino library for Voltronic Axpert MAX (PI30 ASCII protocol). Supports HV7.2kW and LV5kW inverters with 25 inquiry + 30 setting commands.",
  "keywords": [
    "voltronic",
    "axpert",
    "max",
    "inverter",
    "pi30",
    "solar",
    "esp32",
    "esp8266",
    "rs232",
    "off-grid",
    "mppt",
    "battery",
    "home-assistant"
  ],
  "authors": [
    {
      "name": "Kitronic",
      "email": "info@kitronic.tech",
      "url": "https://kitronic.tech",
      "maintainer": true
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kitronic/esp-lib-voltronic-max.git"
  },
  "homepage": "https://github.com/kitronic/esp-lib-voltronic-max",
  "license": "MIT",
  "frameworks": "arduino",
  "platforms": "*",
  "headers": "VoltronicMAX.h",
  "examples": [
    "examples/*.ino"
  ],
  "export": {
    "include": [
      "src/*",
      "examples/*",
      "docs/*",
      "README.md",
      "LICENSE",
      "CHANGELOG.md",
      "library.properties",
      "keywords.txt"
    ],
    "exclude": [
      "test/*",
      ".github/*",
      ".vscode/*",
      "*.pdf"
    ]
  },
  "build": {
    "libArchive": false,
    "flags": [
      "-std=gnu++11"
    ]
  }
}